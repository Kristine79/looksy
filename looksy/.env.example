# LOOKSY — Environment Variables
# Copy this file to .env.local and fill in the values

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/looksy"

# Clerk Auth
# Optional for local development: without Clerk keys the app runs in demo mode
# using the seeded demo user (npm run db:seed).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# AI Provider (OpenAI-compatible — works with OpenAI, OpenCode Go, LiteLLM, vLLM, etc.)
# Required for AI analysis (add to wardrobe) and recommendations.
# API key: AI_API_KEY is preferred; OPENAI_API_KEY is used as a fallback
AI_API_KEY=
# Base URL override for custom OpenAI-compatible endpoints.
# Leave empty for the official OpenAI endpoint (https://api.openai.com/v1)
AI_BASE_URL=
# Model overrides (optional, sensible defaults exist)
AI_MODEL="deepseek-v4-flash"
# Non-reasoning model for final outfit/recommendation generation (Today's Look).
# Optional; defaults to AI_MODEL when unset.
AI_RECOMMENDATION_MODEL="gpt-5.6-luna"
AI_VISION_MODEL="qwen3.7-plus"
AI_EMBEDDING_MODEL="text-embedding-3-small"

# Legacy alias for the OpenAI key (used only when AI_API_KEY is not set)
OPENAI_API_KEY=

# Jina AI (embeddings only — the primary chat provider does not expose embeddings)
# Optional: when set, all embeddings go through Jina; the deterministic fallback
# remains as an emergency path only. Chat and vision are unaffected.
# API key: JINA_API_KEY is preferred; JINA_AI_KEY is accepted as an alias
JINA_API_KEY=
# Base URL override (defaults to https://api.jina.ai/v1)
JINA_BASE_URL=
# Embedding model. Default jina-embeddings-v4 supports 1536 dimensions, which
# matches the existing pgvector column. Models with a lower max (e.g. v3, 1024)
# will fail validation and fall back to deterministic embeddings.
JINA_EMBEDDING_MODEL="jina-embeddings-v4"

# Supabase Storage
# Optional: without these the app stores item photos as data URLs locally (MVP).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="looksy-items"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Logging
LOG_LEVEL="info"
