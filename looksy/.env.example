# LOOKSY — Environment Variables
# Copy this file to .env.local and fill in the values

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/looksy"

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# AI Provider (OpenAI-compatible — works with OpenAI, OpenCode Go, LiteLLM, vLLM, etc.)
# API key: AI_API_KEY is preferred; OPENAI_API_KEY is used as a fallback
AI_API_KEY=
# Base URL override for custom OpenAI-compatible endpoints.
# Leave empty for the official OpenAI endpoint (https://api.openai.com/v1)
AI_BASE_URL=
# Model overrides (optional, sensible defaults exist)
AI_MODEL="gpt-4o"
AI_VISION_MODEL="gpt-4o-mini"
AI_EMBEDDING_MODEL="text-embedding-3-small"

# Legacy alias for the OpenAI key (used only when AI_API_KEY is not set)
OPENAI_API_KEY=

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Logging
LOG_LEVEL="info"
